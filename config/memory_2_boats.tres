[sub_resource type="Resource" id="FatherLine_0"]
script = ExtResource("2")
at_progress = 0.0
text = "PADRE: ¡Seguime, hijo! ¡No me pierdas de vista!"
voice = ExtResource("v_father_seguime")

[sub_resource type="Resource" id="FatherLine_1"]
script = ExtResource("2")
at_progress = 0.07
text = "PADRE: ¡Remá parejo, hijo! ¡Uno y después el otro!"
voice = ExtResource("v_father_rema_parejo")

[sub_resource type="Resource" id="FatherLine_2"]
script = ExtResource("2")
at_progress = 0.2
text = "PADRE: ¡Cuidado con las rocas!"
voice = ExtResource("v_father_rocas")

[sub_resource type="Resource" id="FatherLine_3"]
script = ExtResource("2")
at_progress = 0.6
text = "PADRE: ¡Falta poco! ¡Ya veo las luces de la cabaña!"
voice = ExtResource("v_father_luces")

[sub_resource type="Resource" id="FishLine_0"]
script = ExtResource("2")
at_progress = 1.2
text = "PADRE: Mirá qué calmo está el lago hoy."
voice = ExtResource("v_father_calma")

[sub_resource type="Resource" id="FishLine_1"]
script = ExtResource("2")
at_progress = 5.0
text = "PADRE: Con este atardecer seguro pica algo. Paciencia, hijo."
voice = ExtResource("v_father_paciencia")

[resource]
script = ExtResource("1")
father_lines = Array[ExtResource("2")]([SubResource("FatherLine_0"), SubResource("FatherLine_1"), SubResource("FatherLine_2"), SubResource("FatherLine_3")])
voice_behind = ExtResource("v_father_no_pares")
voice_off_course = ExtResource("v_father_por_aca")
voice_bump = ExtResource("v_father_bien")
voice_tutorial = ExtResource("v_father_rema_parejo")
voice_wave = ExtResource("v_father_ola")
voice_rescue = ExtResource("v_father_agarrate")
fishing_lines = Array[ExtResource("2")]([SubResource("FishLine_0"), SubResource("FishLine_1")])
voice_onset = ExtResource("v_father_recoge")
sfx_wave_roar = ExtResource("s_sfx_wave_roar")
