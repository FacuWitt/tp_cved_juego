[gd_resource type="Resource" script_class="PassageSettings" format=3]

[ext_resource type="Script" path="res://scripts/config/passage_settings.gd" id="1_ps"]
[ext_resource type="Script" path="res://scripts/config/passage_voice.gd" id="2_pv"]
[ext_resource type="AudioStream" path="res://assets/audio/hospital/monitor_beep_muffled.ogg" id="b_muf"]
[ext_resource type="AudioStream" path="res://assets/audio/hospital/monitor_beep_clear.ogg" id="b_clr"]
[ext_resource type="AudioStream" path="res://assets/audio/hospital/v05_enfermera.ogg" id="a_v05_enfermera"]
[ext_resource type="AudioStream" path="res://assets/audio/hospital/v06_hija.ogg" id="a_v06_hija"]
[ext_resource type="AudioStream" path="res://assets/audio/hospital/v07_doctor.ogg" id="a_v07_doctor"]
[ext_resource type="AudioStream" path="res://assets/audio/hospital/v08_abuela.ogg" id="a_v08_abuela"]

[sub_resource type="Resource" id="v1"]
script = ExtResource("2_pv")
stream = ExtResource("a_v05_enfermera")
text = "VOZ (enfermera, un poco más clara): ...le cambio el suero y le acomodo la almohada..."
at_progress = 0.02
duration = 3.2

[sub_resource type="Resource" id="v2"]
script = ExtResource("2_pv")
stream = ExtResource("a_v07_doctor")
text = "VOZ (doctor): ...la actividad cerebral subió un poco esta noche. Es una buena señal..."
at_progress = 0.25
duration = 5.4

[sub_resource type="Resource" id="v3"]
script = ExtResource("2_pv")
stream = ExtResource("a_v08_abuela")
text = "VOZ (abuela): ...decíselo vos, nena. A vos te escucha..."
at_progress = 0.5
duration = 3.3

[sub_resource type="Resource" id="v4"]
script = ExtResource("2_pv")
stream = ExtResource("a_v06_hija")
text = "VOZ (hija): Papá, hoy vine con la abuela. Dice que te parecés al abuelo cuando dormís."
at_progress = 0.6
duration = 6.0

[resource]
script = ExtResource("1_ps")
voices = Array[ExtResource("2_pv")]([SubResource("v1"), SubResource("v2"), SubResource("v3"), SubResource("v4")])
voice_glow_energy = 0.42
voice_light_energy = 7.0
beep_muffled = ExtResource("b_muf")
beep_clear = ExtResource("b_clr")
beep_db_start = -36.0
beep_db_end = -30.0
beep_clarity_start = 0.0
beep_clarity_end = 0.2
