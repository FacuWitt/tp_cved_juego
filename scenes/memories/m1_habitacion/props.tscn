[node name="PoemText" type="Label3D" parent="LullabyNote"]
position = Vector3(3.475, 1.62, 0.5)
rotation_degrees = Vector3(0, -90, 0)
pixel_size = 0.00135
text = "Para acordarte dónde va cada juguete,
cantá la canción.  — la abuela

Cuando el espejo del sol
se asomó a mirar el mar,
los hilos volvieron llenos
y se negaron a soltar.
Un muro de espuma blanca
se levantó a saludar;
y el hierro que nunca flota
le enseñó a descansar.
Y una pequeña sirena
lo esperaba junto al mar;
su amuleto de madera
lo llamaba a regresar."
font_size = 30
modulate = Color(0.12, 0.12, 0.2, 1)
outline_size = 0

